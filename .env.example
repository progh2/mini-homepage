NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GitHub Pages 프로젝트 페이지 하위 경로. 로컬 개발에서는 비워 둡니다.
# NEXT_PUBLIC_BASE_PATH=/mini-homepage

# 한줄평(방명록)과 방문 수를 실제로 저장할 때만 필요합니다. 비워 두면 예시 한줄평이 보입니다.
# 한줄평은 구글 로그인한 사람만 남길 수 있습니다. Firebase 콘솔에서
# Authentication > Sign-in method 의 Google 을 켜고,
# Settings > 승인된 도메인에 배포 주소(예: progh2.github.io)를 넣어야 합니다.
# Firebase 웹 설정값은 비밀키가 아니며 배포된 JS 에 그대로 들어갑니다.
# 실제 접근 제어는 firestore.rules 가 담당합니다.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
