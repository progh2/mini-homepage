rules_version = '2';

/* 한줄평(방명록) 보안 규칙입니다.
   읽기는 누구나, 쓰기는 구글 로그인한 사람만 가능합니다.

   - 필드는 uid, author, text, approved, createdAt 다섯 개만 허용
   - uid 는 로그인한 본인의 uid 여야 함 (남의 이름으로 못 씀)
   - 이름 50자(구글 프로필 이름), 본문 100자 제한
   - createdAt 은 클라이언트가 정할 수 없고 서버 시간만 허용
   - 한 번 쓴 글은 클라이언트에서 수정·삭제 불가 (콘솔에서만 삭제)

   author 는 클라이언트가 보낸 값이라 로그인한 사람이 마음먹으면 표시 이름을
   바꿔 넣을 수 있습니다. 다만 uid 가 함께 남으므로 누가 썼는지는 추적됩니다.
   이름까지 강제하려면 author == request.auth.token.name 을 추가하면 되는데,
   구글 계정에 표시 이름이 없는 경우 토큰에 name 이 빠져 쓰기가 막힙니다.

   승인제로 바꾸려면: read 조건을 resource.data.approved == true 로 바꾸고,
   create 조건의 approved == true 를 approved == false 로 바꾸면 됩니다. */
service cloud.firestore {
  match /databases/{database}/documents {

    /* 비밀글을 볼 수 있는 주인장입니다.
       src/config/linktree.ts 의 ownerUid 와 반드시 같아야 합니다.
       한쪽만 고치면 비밀글이 실제로는 공개되거나, 주인장도 못 보게 됩니다. */
    function ownerUid() {
      return 'hIWd40GYSIgauA0cCOlIea8sOvx1';
    }

    /* 한줄평 문서의 형태 검사입니다. 공개글과 비밀글이 같은 모양을 씁니다. */
    function isValidEntry() {
      return request.resource.data.keys().hasOnly(['uid', 'author', 'text', 'approved', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.author is string
        && request.resource.data.author.size() >= 1
        && request.resource.data.author.size() <= 50
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 100
        && request.resource.data.approved == true
        && request.resource.data.createdAt == request.time;
    }

    /* 고칠 때 검사입니다. 바꿀 수 있는 건 본문뿐입니다.
       uid, author, createdAt 이 그대로여야 남의 글을 자기 것으로 바꾸거나
       작성 시각을 조작할 수 없습니다. */
    function isValidUpdate() {
      return request.resource.data.keys().hasOnly(['uid', 'author', 'text', 'approved', 'createdAt', 'editedAt'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.author == resource.data.author
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.approved == true
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 100
        && request.resource.data.editedAt == request.time;
    }

    /* 수정은 작성자 본인만 합니다. 주인장에게도 수정 권한을 주지 않습니다.
       남이 한 말의 내용을 바꾸면 그 사람이 하지 않은 말이 그 사람 이름으로
       남습니다. 부적절한 글은 지우는 것으로 충분합니다. */
    function canEdit() {
      return request.auth != null && resource.data.uid == request.auth.uid;
    }

    /* 삭제는 작성자 본인과 주인장이 할 수 있습니다. */
    function canDelete() {
      return request.auth != null
        && (resource.data.uid == request.auth.uid || request.auth.uid == ownerUid());
    }

    /* 비밀글입니다. 쓰기는 로그인한 누구나, 읽기는 주인장과 작성자 본인만.

       규칙은 목록 질의의 필터가 아닙니다. resource.data.uid 조건은 문서마다
       달라지므로, 주인장이 아닌 사람은 질의에 where("uid","==",본인) 을 붙여야
       통과합니다. 클라이언트가 그렇게 보냅니다(src/lib/firebase.ts).
       필터 없이 컬렉션 전체를 훑는 질의는 주인장만 통과합니다. */
    match /guestbookSecret/{entryId} {
      allow read: if request.auth != null
        && (request.auth.uid == ownerUid() || resource.data.uid == request.auth.uid);
      allow create: if request.auth != null && isValidEntry();
      allow update: if canEdit() && isValidUpdate();
      allow delete: if canDelete();
    }

    match /guestbook/{entryId} {
      allow read: if true;

      allow create: if request.auth != null && isValidEntry();
      allow update: if canEdit() && isValidUpdate();
      allow delete: if canDelete();
    }

    /* 오에카키 그림입니다.

       그림은 data URL 문자열로 문서 안에 들어갑니다. 길이를 막지 않으면
       1MiB 에 가까운 문서를 계속 밀어 넣을 수 있으므로 상한이 필수입니다.
       앞부분을 잘라 PNG data URL 인지도 확인합니다. 정규식보다 싸게 먹힙니다.

       가림 처리(hidden)는 화면에서 감추는 것이 아니라 읽기 자체를 막습니다.
       화면에서만 감추면 REST 로 문서를 직접 불러 그림을 볼 수 있습니다.
       규칙은 목록 질의를 걸러 주지 않으므로, 주인장이 아닌 사람은 질의에
       where("hidden","==",false) 를 붙여야 통과합니다. 클라이언트가 그렇게
       보냅니다(src/lib/firebase.ts). 가려진 문서를 id 로 직접 읽으려 해도
       hidden == false 조건에서 막힙니다. */
    match /oekaki/{drawingId} {
      allow read: if resource.data.hidden == false
        || (request.auth != null && request.auth.uid == ownerUid());

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'author', 'comment', 'image', 'hidden', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.author is string
        && request.resource.data.author.size() >= 1
        && request.resource.data.author.size() <= 50
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 60
        && request.resource.data.image is string
        && request.resource.data.image.size() <= 300000
        && request.resource.data.image[0:22] == 'data:image/png;base64,'
        && request.resource.data.hidden == false
        && request.resource.data.createdAt == request.time;

      /* 주인장만, 그리고 hidden 한 칸만 바꿀 수 있습니다.
         그림 내용은 고칠 수 없습니다. 지우고 다시 그리면 됩니다. */
      allow update: if request.auth != null
        && request.auth.uid == ownerUid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden'])
        && request.resource.data.hidden is bool;

      allow delete: if canDelete();

      /* 그림에 달리는 댓글입니다. */
      match /comments/{commentId} {
        allow read: if true;

        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['uid', 'author', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.author is string
          && request.resource.data.author.size() >= 1
          && request.resource.data.author.size() <= 50
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 100
          && request.resource.data.createdAt == request.time;

        allow update: if false;
        allow delete: if canDelete();
      }
    }

    /* 미니홈피 왼쪽 위 TODAY / TOTAL 방문 수입니다. 문서 하나만 씁니다.

       - 한 번에 total 을 1씩만 올릴 수 있습니다
       - 날짜(day)가 바뀐 첫 방문이면 today 는 1로 돌아갑니다
       - 필드는 total, today, day 세 개만 허용하고 삭제는 막습니다

       day 문자열이 진짜 오늘인지는 규칙에서 확인하지 못합니다.
       조작하더라도 today 가 1로 리셋되는 정도이고 total 은 영향받지 않습니다. */
    match /counters/site {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['total', 'today', 'day'])
        && request.resource.data.total == 1
        && request.resource.data.today == 1
        && request.resource.data.day is string;

      allow update: if request.resource.data.keys().hasOnly(['total', 'today', 'day'])
        && request.resource.data.total is int
        && request.resource.data.today is int
        && request.resource.data.day is string
        && request.resource.data.total == resource.data.total + 1
        && (
          (request.resource.data.day == resource.data.day
            && request.resource.data.today == resource.data.today + 1)
          || (request.resource.data.day != resource.data.day
            && request.resource.data.today == 1)
        );

      allow delete: if false;
    }

    /* 그 밖의 모든 경로는 차단합니다. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
